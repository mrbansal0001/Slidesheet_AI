DATABASE_URL=sqlite:///./migration.db
# On PostgreSQL, the API/worker connect at runtime as this least-privilege role (created by
# migration 0005) instead of DATABASE_URL's owner role, so RLS (migrations 0005/0006) actually
# applies. The connection URL for it is derived automatically from DATABASE_URL + these two
# values — no separate URL to configure. No-op on the SQLite dev fallback.
APP_DB_ROLE=chatbot_app
APP_DB_PASSWORD=change-me-app-db-password
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
MAX_FAILED_LOGINS_PER_IP=20
IP_LOCKOUT_MINUTES=15
ALLOW_DEV_AUTH=true
SEED_TEST_EMAIL=
SEED_TEST_PASSWORD=
SEED_TEST_ORG=Test Org
AUTO_CREATE_TABLES=true
INGESTION_MODE=sync
REDIS_URL=redis://localhost:6379/0
STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=26214400
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=8

